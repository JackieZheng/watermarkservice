# 运行期日志（含本机路径，不进版本库）
log/*.log
log/*.txt
!log/.gitkeep

# 配置备份
*.bak
*.bak.*
bin/config.json.bak.*

# Python / 编辑器产物
__pycache__/
*.pyc
*.pyo
.vscode/
.idea/

# 临时文件
*.tmp
*.swp
*~

